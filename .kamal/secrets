# Secrets used by Kamal for deployment.
# This file contains references (safe to commit). Actual values are resolved
# from environment variables or commands on the deploying machine.
#
# Set these in your local environment or via a secrets manager:
#   KAMAL_REGISTRY_PASSWORD - GitHub Container Registry access token (write:packages),
#                             resolved here from 1Password via `op`
#   POSTGRES_PASSWORD       - PostgreSQL password for the ip_tracker role
#                             (inside the postgres16 Docker container)

KAMAL_REGISTRY_PASSWORD=$(op read "op://Private/ghcr.io token/credential")
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
